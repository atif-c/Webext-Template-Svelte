{
	"name": "webext-template-svelte",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"vite:dev": "vite",
		"vite:preview": "vite preview",
		"prebuild": "vite build",
		"start:firefox": "web-ext run --source-dir=dist/firefox --no-reload",
		"dev": "npm run build:firefox && concurrently -k -n WATCH,WEBEXT -c cyan,magenta \"npm:watch:firefox\" \"npm:start:firefox\"",
		"watch:firefox": "chokidar \"src/**/*\" -c \"npm run build:firefox\" --initial",
		"watch:chromium": "chokidar \"src/**/*\" -c \"npm run build:chromium\" --initial",
		"build:firefox": "vite build && node build.js firefox",
		"build:chromium": "vite build && node build.js chromium",
		"build": "node build.js",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"prettier:check": "prettier --check .",
		"prettier:write": "prettier --write .",
		"eslint:check": "eslint .",
		"eslint:fix": "eslint --fix .",
		"format": "prettier --write . && eslint --fix ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tsconfig/svelte": "^5.0.4",
		"@types/archiver": "^6.0.3",
		"@types/node": "^24",
		"@types/webextension-polyfill": "^0.12.3",
		"archiver": "^7.0.1",
		"chokidar-cli": "^3.0.0",
		"concurrently": "^9.2.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-jsdoc": "^1.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.35.5",
		"svelte-check": "^4.2.2",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^7.0.4",
		"vite-plugin-static-copy": "^3.1.1",
		"web-ext": "^8.9.0"
	},
	"dependencies": {
		"webextension-polyfill": "^0.12.0"
	}
}
